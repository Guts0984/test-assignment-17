# ---------- compose / host ports ----------
# Host port of nginx: the only public entry point (web + api)
NGINX_PORT=8088
# Postgres, Redis and the channel stub are bound to 127.0.0.1 for local tests only
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
CHANNEL_STUB_HOST_PORT=54000
# Fixed address of nginx inside the compose network (the only trusted proxy)
NGINX_IP=10.231.17.10

# ---------- database (secret: DB_PASSWORD) ----------
DB_HOST=postgres
DB_PORT=5432
DB_USER=hotel
DB_PASSWORD=change-me-db-password
DB_NAME=hotel

# ---------- redis ----------
REDIS_URL=redis://redis:6379

# ---------- api ----------
API_PORT=3000
# Secret that signs staff access tokens (at least 32 characters)
JWT_SECRET=change-me-jwt-secret-at-least-32-characters
# Access token lifetime, seconds
JWT_TTL_SEC=28800
# Comma-separated CIDRs whose X-Forwarded-For is trusted: nginx only
TRUSTED_PROXY_CIDRS=10.231.17.10/32
# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:8088
# Max request body size
BODY_LIMIT=100kb
# Public URL of the site, used in the manage link of guest emails
PUBLIC_WEB_URL=http://localhost:8088
# Hold length, minutes
HOLD_MINUTES=10
# Log level: error | warn | log | debug
LOG_LEVEL=log

# ---------- rate limiting ----------
# General limit per client IP per minute, all API routes (fails open if Redis is down)
RATE_LIMIT_GLOBAL_PER_MIN=600
# Failed logins per (IP + email) inside the window before blocking
LOGIN_MAX_FAILS_PER_IP_EMAIL=5
# Failed logins per IP (password spraying) inside the window before blocking
LOGIN_MAX_FAILS_PER_IP=20
# Failed logins per email from any IP (distributed attack) inside the window before blocking
LOGIN_MAX_FAILS_PER_EMAIL=50
# Window for counting failed logins, seconds
LOGIN_FAIL_WINDOW_SEC=900
# How long a login block lasts, seconds
LOGIN_BLOCK_SEC=900
# Failed guest manage-link lookups per IP per minute
GUEST_LINK_LOOKUPS_PER_MIN=30
# Requests per channel key per minute on channel endpoints
CHANNEL_RATE_PER_MIN=6000

# ---------- channel (secrets: CHANNEL_API_KEY, CHANNEL_HMAC_SECRET) ----------
# Key the channel sends in X-Channel-Key on inbound calls
CHANNEL_API_KEY=change-me-channel-api-key
# Secret of the HMAC-SHA256 signature on outbound pushes (X-Signature)
CHANNEL_HMAC_SECRET=change-me-channel-hmac-secret
# Where the worker pushes rates and availability
CHANNEL_PUSH_URL=http://channel-stub:4000/push
# Debounce per room type, ms: at most one push per room type in this period
CHANNEL_DEBOUNCE_MS=3000
# How many nights ahead each push covers
CHANNEL_PUSH_DAYS=60
# Push HTTP timeout, ms
CHANNEL_PUSH_TIMEOUT_MS=3000

# ---------- worker ----------
# Mail server the worker sends booking emails to (Mailpit in compose; leave SMTP_HOST empty to only log them)
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=bookings@hotel-chain.test
# Host port of the Mailpit web page (inbox of every email the system sent)
MAILPIT_UI_PORT=58025
# How often the Postgres reconciler re-creates due jobs, ms
RECONCILE_INTERVAL_MS=5000
# BullMQ attempts before a job counts as failed
JOB_ATTEMPTS=8

# ---------- channel stub ----------
# Api base URLs the stub sends bookings to (comma-separated)
CHANNEL_STUB_TARGETS=http://api1:3000,http://api2:3000
# Chaos mode: duplicates to both copies, cancel before booking, every 5th push fails
CHANNEL_STUB_CHAOS=false

# ---------- seed ----------
# Password of every seeded staff account
SEED_PASSWORD=demo-pass-123

# ---------- worker / channel stub extras ----------
# Parallel jobs per queue in one worker process
WORKER_CONCURRENCY=5
# How long a running job is protected by its lock; after a kill -9 another worker takes the job over about this long later (+ half of it)
WORKER_LOCK_MS=10000
# Port the channel stub listens on
CHANNEL_STUB_PORT=4000
# In chaos mode a "hanging" push stays silent this long, ms (must exceed CHANNEL_PUSH_TIMEOUT_MS)
CHANNEL_STUB_HANG_MS=6000

# Bookings generated per hotel at the first start (3 hotels: 100000 -> about 300000 bookings in total).
# CI and quick local runs can use a small value together with a short history.
SEED_BOOKINGS_PER_HOTEL=100000
# Days of history (and of future stays) the seed generates, at most 365
SEED_HISTORY_DAYS=365
